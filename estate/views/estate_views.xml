<odoo>
 <record id="estate_action" model="ir.actions.act_window">
    <field name="name">Estate</field>
    <field name="res_model">estate</field>
    <field name="view_mode">list,form,kanban</field>
 </record>
        <record id="estate_view_list" model="ir.ui.view">
        <field name="name">estate.list</field>
        <field name="model">estate</field>
        <field name="arch" type="xml">
            <list string="Channel" editable="bottom">
                <field name="name"/>
                <field name="Postcode"/>
                <field name="Bedrooms"/>
                <field name="Living_Area"/>
                <field name="Expected_Price"/>
                <field name="Selling_Price"/>
                <field name="Avalible_From"/>
            </list>
        </field>


    </record>

<record id="estate_view_form" model="ir.ui.view">
        <field name="name">estate.form</field>
        <field name="model">estate</field>
        <field name="arch" type="xml">
            <form string="Lost Reason">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_od_button" type="object"
                            class="oe_stat_button" icon="fa-star">
                            <div class="o_stat_info">
                                <field name="Bedrooms" class="o_stat_value"/>
                                <span class="o_stat_text"> Leads</span>
                            </div>
                        </button>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
