<odoo>
     
 <record id="estate_action0" model="ir.actions.act_window">
    <field name="name">Estate0</field>
    <field name="res_model">estate</field>
    <field name="view_mode">list,form,kanban</field>
 </record>
     


<record id="estate0_view_form" model="ir.ui.view">
        <field name="name">estate0.form</field>
        <field name="model">estate</field>
        <field name="arch" type="xml">
            <form string="Lost Reason">
                <sheet>
                    <div class="my-class" name="button_box">
                        <button name="action_od_button" type="object"
                            class="oe_stat_button" icon="fa-star">
                            <div class="o_stat_info">
                                <field name="Bedrooms" class="o_stat_value"/>
                                <span class="o_stat_text"> Leads</span>
                            </div>
                        </button>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
